{
 "lead": 0.35,
 "voice_end": 49.631,
 "voice": {
  "engine": "edge",
  "id": "es-AR-ElenaNeural",
  "name": null
 },
 "beats": [
  {
   "id": "b01",
   "text": "¿Sabés por qué tus pacientes no vuelven?",
   "s": 0.35,
   "e": 2.486
  },
  {
   "id": "b02",
   "text": "No es el precio. Y tampoco es la competencia.",
   "s": 2.866,
   "e": 6.381
  },
  {
   "id": "b03",
   "text": "El 70 % de los pacientes que no regresan dicen lo mismo: no se sintieron escuchados.",
   "s": 6.761,
   "e": 12.171
  },
  {
   "id": "b04",
   "text": "La buena noticia es que se arregla con tres hábitos simples.",
   "s": 12.551,
   "e": 15.759
  },
  {
   "id": "b05",
   "text": "Uno: mirá a los ojos en los primeros 10 segundos de la consulta.",
   "s": 16.139,
   "e": 19.858
  },
  {
   "id": "b06",
   "text": "Dos: repetí con tus palabras lo que te contó, antes de dar un diagnóstico.",
   "s": 20.238,
   "e": 24.862
  },
  {
   "id": "b07",
   "text": "Tres: escribile a las cuarenta y ocho horas para preguntar cómo sigue.",
   "s": 25.242,
   "e": 29.188
  },
  {
   "id": "b08",
   "text": "Ese mensaje cuesta treinta segundos, pero el paciente lo recuerda durante meses.",
   "s": 29.568,
   "e": 34.228
  },
  {
   "id": "b09",
   "text": "Antes, el paciente se iba con una receta. Ahora se va con la sensación de que alguien lo cuidó.",
   "s": 34.608,
   "e": 40.754
  },
  {
   "id": "b10",
   "text": "Y un paciente que se siente cuidado vuelve, y además te recomienda.",
   "s": 41.134,
   "e": 44.913
  },
  {
   "id": "b11",
   "text": "Si te sirvió, seguime para más ideas que hacen crecer tu consultorio.",
   "s": 45.293,
   "e": 49.631
  }
 ],
